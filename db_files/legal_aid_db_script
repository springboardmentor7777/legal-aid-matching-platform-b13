-- ===============================
-- Table: roles
-- Purpose: Stores all system roles
-- Used for role-based access control
-- ===============================

CREATE TABLE roles (
    -- Primary key for roles table
    id SERIAL PRIMARY KEY,
    -- Role name (USER, LAWYER, NGO, ADMIN)
    name VARCHAR(50) UNIQUE NOT NULL
);
-- Index to speed up role lookups
CREATE INDEX IF NOT EXISTS idx_roles_name
ON roles(name);
-- Insert default roles required by the application
INSERT INTO roles (name)
VALUES
('USER'),
('LAWYER'),
('NGO'),
('ADMIN');
-- ===============================
-- Table: users
-- Purpose: Stores login and basic user details
-- Each user is assigned a role
-- ===============================

CREATE TABLE IF NOT EXISTS users (

    -- Primary key for users table
    id SERIAL PRIMARY KEY,

    -- Full name of the user
    full_name VARCHAR(100) NOT NULL,

    -- Email address (must be unique)
    email VARCHAR(150) NOT NULL,

    -- Encrypted password (null for OAuth users)
    password VARCHAR(255),

    -- Role reference (FK to roles table)
    role_id INT NOT NULL,

    -- Login provider: LOCAL / GOOGLE / GITHUB
    provider VARCHAR(50),

    -- Record creation timestamp
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    -- Foreign key constraint to roles table
    CONSTRAINT fk_role
        FOREIGN KEY (role_id)
        REFERENCES roles(id)
);


